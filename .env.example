# Copy this to .env and fill in real values. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=changeme-generate-a-50-char-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=mailbox.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://mailbox.example.com
# Set to 0 only if HTTPS is terminated *before* gunicorn (e.g. Cloudflare flexible).
DJANGO_SECURE_SSL_REDIRECT=1

# --- Database (MySQL) ---
DB_NAME=mailbox_transfer
DB_USER=mailtransfer
DB_PASSWORD=changeme
DB_HOST=your-mysql-host
DB_PORT=3306

# --- Google OAuth (also stored in DB SocialApp row; these are read by allauth at startup) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Mailbox password encryption ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this invalidates all existing encrypted passwords in the DB.
MAILBOX_FERNET_KEY=

# --- Cloudflare Turnstile (bot protection on the signup form) ---
# Get free keys at https://dash.cloudflare.com → Turnstile → Add widget.
# Leave BOTH blank locally to disable the CAPTCHA (signup still works).
# For local testing use Cloudflare's always-pass test keys (work on any host):
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- SMTP (verification + admin-notify emails) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Mailbox Transfer <no-reply@example.com>
ADMIN_EMAIL=
